{
  "name": "@alex/migrate",
  "version": "0.1.0",
  "description": "Кросспроектный CLI для миграций БД на базе umzug",
  "type": "module",
  "bin": {
    "migrate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "test:bin": "npm run build && vitest run tests/bin-"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "pg": "^8.23.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.20.7",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
